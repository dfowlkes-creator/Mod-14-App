# ===================================
# SETUP INSTRUCTIONS
# ===================================
# 1. Copy this file and rename it to: application.properties
# 2. Fill in your real values below (replace anything in <angle brackets>)
# 3. Set the same keys as environment variables in your IDE run configuration
#    (e.g. IntelliJ: Run > Edit Configurations > Environment Variables)
# 4. NEVER commit application.properties — it is already listed in .gitignore

# ===================================
# SERVER CONFIGURATION
# ===================================
server.port=8080

# ===================================
# DATABASE CONNECTION CONFIGURATION
# ===================================
spring.datasource.url=jdbc:mysql://localhost:3306/mod13_rdelivery
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ===================================
# TWILIO CONFIGURATION (SMS)
# ===================================
twilio.account.sid=${TWILIO_ACCOUNT_SID}
twilio.auth.token=${TWILIO_AUTH_TOKEN}
twilio.phone.number=${TWILIO_PHONE_NUMBER}

# ===================================
# NOTIFY.EU CONFIGURATION (Email)
# ===================================
notify.secret.key=${NOTIFY_SECRET_KEY}
notify.client.id=${NOTIFY_CLIENT_ID}
notify.template.id=${NOTIFY_TEMPLATE_ID}
notifyeu.api.key=${NOTIFYEU_API_KEY}
notifyeu.sender=${NOTIFYEU_SENDER}
notifyeu.recipient=${NOTIFYEU_RECIPIENT}

# ===================================
# JPA / HIBERNATE CONFIGURATION
# ===================================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# ===================================
# THYMELEAF CONFIGURATION
# ===================================
spring.thymeleaf.cache=false
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html

# ===================================
# SPRING PROFILE CONFIGURATION
# ===================================
spring.profiles.active=manual-seeding

# ===================================
# DEVTOOLS CONFIGURATION
# ===================================
spring.devtools.restart.enabled=true
spring.devtools.restart.additional-paths=src/main/java
spring.devtools.restart.exclude=**/*.xml,**/*.properties

# ===================================
# LOGGING CONFIGURATION
# ===================================
logging.level.org.springframework=INFO
logging.level.com.rocketFoodDelivery=DEBUG
