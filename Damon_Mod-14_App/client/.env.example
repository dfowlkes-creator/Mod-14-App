# Copy this file and rename it to .env
# Set EXPO_PUBLIC_API_URL to the IP address and port where your Spring Boot server is running.
# Example values:
#   Local network:  http://192.168.1.100:8080
#   Android emulator talking to host machine: http://10.0.2.2:8080
#   iOS simulator talking to host machine:    http://localhost:8080

EXPO_PUBLIC_API_URL=http://<your-server-ip>:8080
